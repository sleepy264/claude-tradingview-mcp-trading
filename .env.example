# ─── Bot v3 — BingX ───────────────────────────────────────────────────────────
# Cópia funcional do Bot v2 (Bybit) a operar na BingX, com canal Telegram próprio.

# BingX API credentials
# BingX → Perfil → API Management → Create API
# Permissões: Perpetual Futures Trading (ler + negociar). Withdrawals: OFF.
BINGX_API_KEY=your_api_key_here
BINGX_SECRET_KEY=your_secret_key_here
BINGX_BASE_URL=https://open-api.bingx.com

# Segredo do webhook — usa um DIFERENTE do bot v2 para os alertas não se cruzarem
WEBHOOK_SECRET=trv3secret

# Telegram — bot e chat PRÓPRIOS do v3 (criar novo bot no @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Persistência (Railway Volume) — sem isto o estado perde-se a cada redeploy
DATA_DIR=/data

# ─── Execução ─────────────────────────────────────────────────────────────────
PAPER_TRADING=true            # true até validares; false para operar a sério
TRADE_MODE=futures
MAX_TRADE_SIZE_USD=6
LEVERAGE=100                  # sobreposto pelo campo "leverage" do payload TradingView

# ─── Risco / SL ───────────────────────────────────────────────────────────────
ATR_MULTIPLIER=4
ATR_PERIOD=14
CANDLE_INTERVAL=15
STOP_LOSS_PCT=0.002           # fallback quando o ATR falha
MAX_SL_PCT=0.08               # bloqueia entradas com SL implícito > 8%
TRAILING_ATR_MULT=2           # trailing separado do SL
MAX_REVERSAL_LOSS_USD=6       # segura o perdedor até este valor
MAX_REVERSAL_HARD_CAP_USD=15  # acima disto corta sempre (proteção Cross)

# ─── Filtros de entrada ───────────────────────────────────────────────────────
CHASE_LIMIT=true
CHASE_LIMIT_TIMEOUT_MS=8000
FEE_VIABILITY_THRESHOLD=1.5
MIN_RR=1.35
MAX_TP_PCT=0.12
TREND_MARGIN_PCT=0.01
TREND_INTERVAL=60
TREND_EMA_PERIOD=50
VOLUME_FILTER_MULT=0.5
MAX_SPREAD_PCT=0.001
COOLDOWN_AFTER_SL_MS=900000

# ─── Commit / re-entradas ─────────────────────────────────────────────────────
TRAILING_REENTRY_ENABLED=true
REENTRY_COOLDOWN_MS=3600000
REENTRY_EXPIRY_HOURS=6
COMMIT_PULLBACK_ATR_MULT=0.5
COMMIT_BREAKOUT_ATR_MULT=0.5
# Chase da ordem limite de re-entrada (se não encher e o preço se afastar, aproxima-a).
COMMIT_CHASE_ENABLED=true
COMMIT_CHASE_INTERVAL_MS=300000  # reajusta de 5 em 5 min
COMMIT_CHASE_STEP_PCT=0.33       # fecha 1/3 do que falta até ao preço, por passo
COMMIT_CHASE_MAX_PCT=0.7         # NUNCA cede mais de 70% do pullback (guarda 30% de margem)
COMMIT_CHASE_MAX_STEPS=6
COMMIT_MIN_GAIN_USD=5
AUTO_COMMIT_GAIN_PCT=130      # encaixa quando o ganho ≥ 130% da margem da posição
POSITION_POLL_MS=30000        # cadência do auto-commit, /target3 e ratchet do SL (30s)

# ─── Ratchet do SL (acompanha o lucro, nunca recua) ───────────────────────────
# Move o PRÓPRIO stop, como fazia a Bybit — inclui posições abertas à mão na BingX.
# Nunca cria um SL onde não existe; se mexeres no stop na app, re-ancora no teu valor.
TRAIL_RATCHET_ENABLED=true
TRAIL_RATCHET_MIN_STEP_PCT=0.1   # só mexe quando a melhoria vale ≥10% da distância

# ─── Outros ───────────────────────────────────────────────────────────────────
POSITION_TIMEOUT_HOURS=0
BREAK_EVEN_BUFFER_ATR=0.3
# TRADE_HOURS_START / TRADE_HOURS_END — deixar por definir = 24/7

# Equivalências de símbolos entre TradingView/Bybit e BingX (o MESMO ativo com nomes
# diferentes). Formato: TVSYMBOL:BINGXSYMBOL separados por vírgula.
# Já inclui por defeito: LITUSDT:LIGHTER-USDT
# SYMBOL_ALIASES=LITUSDT:LIGHTER-USDT
